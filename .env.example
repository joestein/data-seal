# Application
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
APP_URL=http://localhost:8000
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://dataseal:dataseal@localhost:5432/dataseal
# Sync URL used by Celery workers and Alembic
DATABASE_URL_SYNC=postgresql://dataseal:dataseal@localhost:5432/dataseal

# Valkey
VALKEY_URL=redis://localhost:6379/0

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@dataseal.example.com
SMTP_FROM_NAME=DataSeal
SMTP_USE_TLS=false

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage

# Signing
SIGNING_TOKEN_EXPIRY_HOURS=72
MAX_DOCUMENT_SIZE_MB=25
MAX_DOCUMENTS_PER_ENVELOPE=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# OAuth / JWT
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7
